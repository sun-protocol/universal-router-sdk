# Nile only. Never commit a funded account key.
NILE_FULL_NODE=https://nile.trongrid.io
NILE_PRIVATE_KEY=
# Optional: reuse another ignored env file without copying its key here.
NILE_ENV_FILE=
# Public contract defaults live in config/nile.json. Override only for another deployment.
NILE_ROUTER_ADDRESS=
NILE_PERMIT2_ADDRESS=

# Scenario addresses. Use a recipient different from the payer when testing TRX input.
NILE_RECIPIENT=
NILE_REFERRAL_RECIPIENT=
NILE_TOKEN_IN=
NILE_TOKEN_OUT=

# Required in addition to the `execute` CLI command.
NILE_SEND=false
